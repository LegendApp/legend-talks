{
  "compilerOptions": {
    "allowJs": true,
    "allowImportingTsExtensions": true,
    "esModuleInterop": true,
    "jsx": "react-jsx",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "noEmit": true,
    "resolveJsonModule": true,
    "skipLibCheck": true,
    "strict": true,
    "target": "ES2022",
    "types": [
      "node"
    ],
    "paths": {
      "slides:*": [
        "./test-support/legend-apps/packages/slides-effects/packs/*"
      ]
    }
  },
  "include": [
    "*/**/*.ts",
    "*/**/*.tsx",
    "*/**/*.mjs",
    "uniwind-env.d.ts"
  ],
  "exclude": [
    "**/__tests__",
    "**/*.test.*",
    "node_modules",
    "test-support",
    "scripts"
  ]
}
